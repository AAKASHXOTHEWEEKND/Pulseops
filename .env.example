# Copy to .env for local overrides. NEVER commit a real .env with secrets.
# docker-compose reads these; sensible defaults exist for everything.

# Postgres password used by db + api + worker (compose only).
POSTGRES_PASSWORD=pulseops

# Image/version stamp. In CI this is set to the git commit SHA.
APP_VERSION=local

# Controlled-failure demo toggle. Set true to make /health/ready return 503.
BREAK_READINESS=false

# --- The following are what the app itself reads (already wired in compose) ---
# DATABASE_URL=postgresql+psycopg://pulseops:pulseops@db:5432/pulseops
# REDIS_URL=redis://redis:6379/0
# APP_ENV=local
# LOG_LEVEL=INFO
