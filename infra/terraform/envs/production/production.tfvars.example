# Copy to production.tfvars and fill image tags (immutable: git SHA or semver).
# Production uses larger sizing, Multi-AZ RDS, longer log retention.

environment = "production"
aws_region  = "ap-south-1"
vpc_cidr    = "10.30.0.0/16"
az_count    = 2

api_image = "<account>.dkr.ecr.ap-south-1.amazonaws.com/pulseops-production-app:REPLACE_SHA"
web_image = "<account>.dkr.ecr.ap-south-1.amazonaws.com/pulseops-production-web:REPLACE_SHA"

api_desired_count    = 3
worker_desired_count = 2
api_cpu              = 512
api_memory           = 1024
worker_cpu           = 512
worker_memory        = 1024
db_instance_class    = "db.t4g.small"
log_retention_days   = 30

tags = {
  Owner = "platform-team"
}
